---
import { getCollection } from 'astro:content';
import ResearchProjectCard from '../../components/ResearchProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const research = (await getCollection('research', ({ data }) => data.complete))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Research Projects" description="Detailed research projects in molecular modeling, therapeutic design, predictive methods, environmental toxicology, and biomolecular interfaces.">
  <header class="research-index-header shell">
    <p class="eyebrow">Detailed work</p>
    <h1>Research projects</h1>
  </header>

  <div class="research-themes shell">
    {research.map((entry) => {
      return (
        <section class="research-theme" id={entry.id} aria-labelledby={`${entry.id}-heading`}>
          <h2 id={`${entry.id}-heading`}>{entry.data.title}</h2>

          <div class="project-list">
            {entry.data.projects.map((project, index) => (
              <ResearchProjectCard project={project} cardId={`${entry.id}-project-${index}`} />
            ))}
          </div>
        </section>
      );
    })}
  </div>

</BaseLayout>
